# Copie para .env (que NÃO vai para o git) e preencha.
# Sem DB_URL a API usa o H2 em memória e os dados somem ao reiniciar.

# Supabase > Connect > Direct > "Session pooler" (funciona em redes só com IPv4).
# Copie o host exato que o painel mostra (ex.: aws-1-sa-east-1.pooler.supabase.com)
# e troque [REF] pelo id do seu projeto.
DB_URL=jdbc:postgresql://[HOST-DO-POOLER]:5432/postgres?sslmode=require
DB_USER=postgres.[REF]
DB_PASSWORD=

# Opcional
# DB_POOL_SIZE=5
# CORS_ORIGINS=http://localhost:5173
